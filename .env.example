# SentinelAML Environment Configuration Example
# Place your real credentials in .env or .streamlit/secrets.toml (both excluded from Git)

GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional LLM Provider Override ("auto", "gemini", "anthropic", "openai", "mock")
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-2.0-flash

